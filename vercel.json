{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.smartart254.org" }],
      "destination": "https://smartart254.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/schools", "destination": "/schools/index.html" },
    { "source": "/workshops", "destination": "/workshops/index.html" },
    { "source": "/events", "destination": "/events/index.html" },
    { "source": "/highlights", "destination": "/highlights/index.html" },
    { "source": "/book", "destination": "/book/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/jobs", "destination": "/jobs/index.html" },
    { "source": "/signin", "destination": "/signin/index.html" },
    { "source": "/signup", "destination": "/signup/index.html" },
    { "source": "/member", "destination": "/member/index.html" },
    { "source": "/talk", "destination": "/talk/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}